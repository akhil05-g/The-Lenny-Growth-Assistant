# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Environment (development, production, testing)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Persistence Configuration
# ------------------------------------------------------------------------------
# Default: Falls back automatically to SQLite (lenny_assistant.db) if PostgreSQL
# is unreachable, allowing immediate evaluator testing.
# For production PostgreSQL (Supabase / Railway / Docker):
DATABASE_URL=sqlite+aiosqlite:///./lenny_assistant.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant

# ------------------------------------------------------------------------------
# Model Configuration & Providers
# ------------------------------------------------------------------------------
# Active LLM Provider: 'ollama' | 'anthropic' | 'openai' | 'resilient_local'
# Switch to 'anthropic' to prove the toggle works — no working key required.
# With no key set, /api/health will report: is_available=false, "Anthropic API key not configured"
ACTIVE_PROVIDER=anthropic


# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Cloud LLM API Keys (leave blank to demo toggle without a live key)
# Set ACTIVE_PROVIDER=anthropic to switch; /api/health will honestly report availability.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Knowledge Base & Retrieval
# ------------------------------------------------------------------------------
TRANSCRIPTS_DATA_DIR=data/episodes
INDEX_DATA_DIR=data/index
TOP_K_RETRIEVAL=5
MAX_CONTEXT_TOKENS=3500

# ------------------------------------------------------------------------------
# Observability & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_QUERY_TELEMETRY=true
